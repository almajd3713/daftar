# Copy to .env for the dev stack. Never commit .env.
# Dev-only Postgres password. Bundles generate their own secrets (C-8).
POSTGRES_PASSWORD=
# Host port for the dev database; bound to 127.0.0.1 only.
DAFTAR_DEV_DB_PORT=5433

# C-10 config keys
# Inside the Compose network the worker reaches Postgres at host "postgres".
# Build this from POSTGRES_PASSWORD: postgresql://daftar:<password>@postgres:5432/daftar
DAFTAR_DATABASE_URL=
DAFTAR_WORKER_URL=http://worker:8000
DAFTAR_SPEC_PATH=
# No default, on purpose. The runtime refuses to start without it (WP-9).
DAFTAR_SECRET=
DAFTAR_DEFAULT_LOCALE=fr-DZ
DAFTAR_TZ=Africa/Algiers
# Empty means rules only (R-11).
DAFTAR_LLM_BASE_URL=
DAFTAR_LLM_MODEL=
