[
  { "name": "key with capitals", "base": "tutoring-register", "at": ["entities", 0, "key"], "set": "Classes", "expect": ["entities[0].key"] },
  { "name": "key with a trailing newline", "base": "tutoring-register", "at": ["entities", 0, "key"], "set": "classes\n", "expect": ["entities[0].key"] },
  { "name": "key that is an SQL injection", "base": "tutoring-register", "at": ["entities", 0, "key"], "set": "x\"; drop table users; --", "expect": ["entities[0].key"] },
  { "name": "key of 64 characters", "base": "tutoring-register", "at": ["entities", 0, "key"], "set": "a123456789012345678901234567890123456789012345678901234567890123", "expect": ["entities[0].key"] },
  { "name": "label without Arabic", "base": "tutoring-register", "at": ["entities", 0, "label", "ar"], "remove": true, "expect": ["entities[0].label.ar"] },
  { "name": "blank label", "base": "tutoring-register", "at": ["entities", 0, "label", "fr"], "set": "   ", "expect": ["entities[0].label.fr"] },
  { "name": "unknown field type", "base": "tutoring-register", "at": ["entities", 1, "fields", 0, "type"], "set": "currency", "expect": ["entities[1].fields[0].type"] },
  { "name": "field without a type", "base": "tutoring-register", "at": ["entities", 1, "fields", 0, "type"], "remove": true, "expect": ["entities[1].fields[0].type"] },
  { "name": "choice field without choices", "base": "tutoring-register", "at": ["entities", 1, "fields", 4, "choices"], "remove": true, "expect": ["entities[1].fields[4].choices"] },
  { "name": "link field without a target", "base": "tutoring-register", "at": ["entities", 1, "fields", 5, "target"], "remove": true, "expect": ["entities[1].fields[5].target"] },
  { "name": "personal data without retention", "base": "tutoring-register", "at": ["entities", 1, "retention"], "remove": true, "expect": ["entities[1].retention"] },
  { "name": "unknown entity property", "base": "tutoring-register", "at": ["entities", 0, "colour"], "set": "#ffffff", "expect": ["entities[0].colour"] },
  { "name": "unknown entity kind", "base": "tutoring-register", "at": ["entities", 0, "kind"], "set": "calculator", "expect": ["entities[0].kind"] },
  { "name": "unsupported major version", "base": "tutoring-register", "at": ["specVersion"], "set": "2.0.0", "expect": ["specVersion"] },
  { "name": "missing top-level section", "base": "tutoring-register", "at": ["mapping"], "remove": true, "expect": ["mapping"] },
  { "name": "currency other than DZD", "base": "tutoring-register", "at": ["app", "currency"], "set": "EUR", "expect": ["app.currency"] },
  { "name": "plain ar locale", "base": "tutoring-register", "at": ["app", "defaultLocale"], "set": "ar", "expect": ["app.defaultLocale"] },
  { "name": "short workbook hash", "base": "tutoring-register", "at": ["entities", 1, "provenance", "workbookSha256"], "set": "abc123", "expect": ["entities[1].provenance.workbookSha256"] },
  { "name": "rejected decision in provenance", "base": "tutoring-register", "at": ["entities", 1, "provenance", "decision"], "set": "rejected", "expect": ["entities[1].provenance.decision"] },
  { "name": "decision time with Arabic digits", "base": "tutoring-register", "at": ["entities", 1, "provenance", "decidedAt"], "set": "٢٠٢٦-11-03T10:15:00Z", "expect": ["entities[1].provenance.decidedAt"] },
  { "name": "translated formula without a tree", "base": "payments-ledger", "at": ["entities", 0, "fields", 7, "computed", "expr"], "remove": true, "expect": ["entities[0].fields[7].computed.expr"] },
  { "name": "engine formula with a tree", "base": "payments-ledger", "at": ["entities", 0, "fields", 8, "computed", "expr"], "set": { "kind": "literal", "valueType": "number", "value": 1 }, "expect": ["entities[0].fields[8].computed.expr"] },
  { "name": "unknown way to evaluate a formula", "base": "payments-ledger", "at": ["entities", 0, "fields", 7, "computed", "eval"], "set": "sql", "expect": ["entities[0].fields[7].computed.eval"] },
  { "name": "nested expression of an unknown kind", "base": "payments-ledger", "at": ["entities", 0, "fields", 7, "computed", "expr", "args", 1, "kind"], "set": "sql", "expect": ["entities[0].fields[7].computed.expr.args[1].kind"] },
  { "name": "nested expression without a type", "base": "payments-ledger", "at": ["entities", 0, "fields", 7, "computed", "expr", "args", 0, "valueType"], "remove": true, "expect": ["entities[0].fields[7].computed.expr.args[0].valueType"] },
  { "name": "unknown colour format", "base": "payments-ledger", "at": ["entities", 0, "fields", 9, "choices", 0, "colour"], "set": "red", "expect": ["entities[0].fields[9].choices[0].colour"] },
  { "name": "chart without a grouping", "base": "payments-ledger", "at": ["dashboards", 0, "widgets", 1, "groupBy"], "remove": true, "expect": ["dashboards[0].widgets[1].groupBy"] },
  { "name": "sum without a field", "base": "payments-ledger", "at": ["dashboards", 0, "widgets", 0, "field"], "remove": true, "expect": ["dashboards[0].widgets[0].field"] },
  { "name": "header row zero", "base": "payments-ledger", "at": ["mapping", 0, "headerRow"], "set": 0, "expect": ["mapping[0].headerRow"] },
  { "name": "month thirteen", "base": "payments-ledger", "at": ["mapping", 0, "sources", 0, "period"], "set": "2026-13", "expect": ["mapping[0].sources[0].period"] },
  { "name": "mapping without key columns", "base": "payments-ledger", "at": ["mapping", 0, "keyColumns"], "set": [], "expect": ["mapping[0].keyColumns"] },
  { "name": "test case with a bad input key", "base": "fee-calculator", "at": ["calculators", 0, "testCases", 0, "inputs", "Bad-Key"], "set": 1, "expect": ["calculators[0].testCases[0].inputs.Bad-Key"] },
  { "name": "calculator cell outside A1 form", "base": "fee-calculator", "at": ["calculators", 0, "cells", 0, "ref"], "set": "$B$2", "expect": ["calculators[0].cells[0].ref"] },
  { "name": "unknown role", "base": "fee-calculator", "at": ["roles", 0, "key"], "set": "admin", "expect": ["roles[0].key"] },
  { "name": "view of an unknown type", "base": "repair-tracker", "at": ["views", 0, "type"], "set": "calendar", "expect": ["views[0].type"] },
  { "name": "board without a workflow", "base": "repair-tracker", "at": ["views", 0, "workflow"], "remove": true, "expect": ["views[0].workflow"] },
  { "name": "transition with no roles", "base": "repair-tracker", "at": ["workflows", 0, "transitions", 0, "roles"], "set": [], "expect": ["workflows[0].transitions[0].roles"] },
  {
    "name": "several errors are all reported",
    "base": "repair-tracker",
    "at": ["entities", 0, "fields", 0, "label"],
    "set": { "fr": "Appareil" },
    "alsoAt": ["reminders", 0, "offsetDays"],
    "alsoSet": "tomorrow",
    "expect": ["entities[0].fields[0].label.ar", "reminders[0].offsetDays"]
  }
]
