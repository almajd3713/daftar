{
  "name": "@daftar/spec",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./types": { "types": "./dist/generated/spec.d.ts", "default": "./dist/generated/spec.js" },
    "./schema/daftar.spec.schema.json": "./schema/daftar.spec.schema.json"
  },
  "files": ["dist", "schema", "examples"],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
